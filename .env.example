PORT=8085
TZL_ROOT_DOMAIN=rayaz.org
TZL_BASE_URL=https://icons.rayaz.org
TZL_TRUST_PROXY=1
ICONS_REPO_URL=https://github.com/YOUR-USER/icons.git
ICONS_REPO_BRANCH=main
ICONS_SUBDIR=icons
SYNC_INTERVAL_SECONDS=300
SYNC_TOKEN=change-me-long-random-string
SOURCE_URL=https://github.com/YOUR-USER/icons
CACHE_MAX_AGE=86400
CORS_ORIGIN=*
ADMIN_ENABLED=true
# Optional: skip the first-run token and create the admin from the environment (min 10 characters).
# TZL_ADMIN_USER=admin
# TZL_ADMIN_PASSWORD=
# The old names PUBLIC_URL, TRUST_PROXY, ADMIN_USER and ADMIN_PASSWORD still work.
